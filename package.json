{
    "name": "@wae/workspace",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "description": "WAE：框架无关 client + server + Rust host；adapter 仅 vue/react/svelte/solid；examples 按用途分类",
    "repository": "https://github.com/oovm/wae",
    "homepage": "https://github.com/oovm/wae",
    "license": "MIT",
    "scripts": {
        "build": "pnpm -r --if-present build",
        "check": "pnpm run check:rust && pnpm run check:ts && pnpm run check:boundary && pnpm run check:host-http && pnpm run check:host-cloudflare-kv && pnpm run check:host-deno",
        "check:rust": "cargo check --workspace",
        "check:ts": "node scripts/check-ts.mjs",
        "check:boundary": "node scripts/check-boundary.mjs",
        "check:host-http": "node scripts/host-http.mjs",
        "check:host-cloudflare-kv": "node scripts/host-cloudflare-kv.mjs",
        "check:host-deno": "node scripts/host-deno.mjs",
        "check:examples": "pnpm --filter \"./projects/examples/**\" run check",
        "test": "pnpm -r --if-present test && cargo test --workspace",
        "examples": "pnpm --filter \"./projects/examples/**\" run build",
        "wae": "pnpm --filter @wae/wae exec node ./bin/wae.mjs",
        "fmt": "nifty format",
        "fmt:check": "nifty format --check",
        "publish:dry": "node scripts/publish.mjs",
        "publish:npm": "node scripts/publish.mjs --execute",
        "build:native": "node scripts/build-platform-native.mjs",
        "verify:native": "node scripts/verify-platform-native.mjs --skip-mobile",
        "pack:product-native": "node scripts/pack-product-native.mjs"
    },
    "devDependencies": {
        "@doki-land/nifty": "^0.0.6",
        "@wae/core": "workspace:*",
        "@wae/server": "workspace:*",
        "@wae/serverless": "workspace:*",
        "typescript": "catalog:"
    }
}
