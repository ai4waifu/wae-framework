{
    "name": "@wae/server",
    "version": "0.0.0",
    "description": "Node.js / Deno 常驻服务端宿主（`/node`、`/deno` 子路径）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js",
            "default": "./dist/node/index.js"
        },
        "./deno": {
            "types": "./dist/deno/index.d.ts",
            "import": "./dist/deno/index.js",
            "default": "./dist/deno/index.js"
        },
        "./app": {
            "types": "./dist/app/index.d.ts",
            "import": "./dist/app/index.js",
            "default": "./dist/app/index.js"
        },
        "./websocket": {
            "types": "./dist/websocket/index.d.ts",
            "import": "./dist/websocket/index.js",
            "default": "./dist/websocket/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "license": "MIT",
    "dependencies": {
        "@wae/types": "workspace:*",
        "@wae/core": "workspace:*",
        "@wae/protocol": "workspace:*",
        "ws": "^8.18.3"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/ws": "^8.18.1",
        "typescript": "catalog:"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
