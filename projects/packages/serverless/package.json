{
    "name": "@wae/serverless",
    "version": "0.0.0",
    "description": "Cloudflare Workers 等按请求运行的边缘宿主（`/cloudflare` 子路径）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./cloudflare": {
            "types": "./dist/cloudflare/index.d.ts",
            "import": "./dist/cloudflare/index.js",
            "default": "./dist/cloudflare/index.js"
        },
        "./cloudflare/durable-objects": {
            "types": "./dist/cloudflare/durable-objects.d.ts",
            "import": "./dist/cloudflare/durable-objects.js",
            "default": "./dist/cloudflare/durable-objects.js"
        },
        "./cloudflare/queues": {
            "types": "./dist/cloudflare/queues.d.ts",
            "import": "./dist/cloudflare/queues.js",
            "default": "./dist/cloudflare/queues.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "check": "tsc -p tsconfig.json --noEmit",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@wae/core": "workspace:*",
        "@wae/types": "workspace:*",
        "@wae/protocol": "workspace:*"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
