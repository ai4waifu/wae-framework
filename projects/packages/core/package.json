{
    "name": "@wae/core",
    "version": "0.0.0",
    "description": "WAE 共享 TypeScript runtime（跨宿主 HTTP app、工具；非 UI、非协议编解码）",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./websocket": {
            "types": "./dist/websocket/index.d.ts",
            "import": "./dist/websocket/index.js",
            "default": "./dist/websocket/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "check": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.json",
        "prepublishOnly": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@wae/types": "workspace:*"
    },
    "devDependencies": {
        "typescript": "catalog:"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/wae.git"
    },
    "homepage": "https://github.com/oovm/wae",
    "publishConfig": {
        "access": "public"
    }
}
